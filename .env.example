PORT=4008
CORE_API_URL=http://localhost:3000
# Core's Ed25519 public key (PEM, `\n` escapes allowed): the BFF verifies the session tokens Core signs
# with it (EdDSA, bffs-lib requireSession, MAIR-680) and refuses to start without a key.
JWT_PUBLIC_KEY=
# OpenTelemetry collector (MAIR-504): unset = telemetry off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_settings",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "SettingsProfile": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Security"
          },
          "last_name": {
            "type": "string",
            "example": "Admin"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "security-admin@mairie360.fr"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "0612345678"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email"
        ]
      },
      "SettingsProfilePatch": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^<>]*$",
            "example": "Security"
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^<>]*$",
            "example": "Admin"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "example": "security-admin@mairie360.fr"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:\\+?\\d(?:[\\s.-]?\\d){9,13})?$",
            "example": "0612345678"
          }
        },
        "additionalProperties": false
      },
      "SettingsBootstrap": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/SettingsProfile"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "device_info": {
                  "type": "string"
                },
                "ip_address": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string"
                },
                "revoked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "device_info",
                "ip_address",
                "created_at",
                "expires_at"
              ]
            }
          },
          "sources": {
            "type": "object",
            "properties": {
              "sessions": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            },
            "required": [
              "sessions"
            ]
          }
        },
        "required": [
          "profile",
          "sessions",
          "sources"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Connectivity"
        ],
        "summary": "Vérifie la santé du BFF",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "responses": {
          "200": {
            "description": "Services disponibles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Service indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settings/bootstrap": {
      "get": {
        "responses": {
          "200": {
            "description": "Profil et sessions Core de l’utilisateur connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsBootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Profil indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Core non configuré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

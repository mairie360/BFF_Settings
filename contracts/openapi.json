{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_settings",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNPROCESSABLE_ENTITY",
                  "TOO_MANY_REQUESTS",
                  "INTERNAL_ERROR",
                  "BAD_GATEWAY",
                  "SERVICE_UNAVAILABLE",
                  "GATEWAY_TIMEOUT"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CheckApisResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "Error"
            ]
          },
          "core_api": {
            "type": "string",
            "enum": [
              "Connected",
              "Unreachable"
            ]
          }
        },
        "required": [
          "status",
          "core_api"
        ]
      },
      "SettingsProfile": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "example": "Security"
          },
          "last_name": {
            "type": "string",
            "example": "Admin"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "security-admin@mairie360.fr"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "+33612345678"
          },
          "phone_country": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 3166-1 alpha-2 country of the phone",
            "example": "FR"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email"
        ]
      },
      "SettingsProfilePatch": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^<>]*$",
            "example": "Security"
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^<>]*$",
            "example": "Admin"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "example": "security-admin@mairie360.fr"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32,
            "pattern": "^(?:\\+?[\\d\\s.()-]+)?$",
            "example": "06 12 34 56 78"
          },
          "phone_country": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$",
            "example": "FR"
          },
          "current_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Current password of the account, required when `email` changes the current address",
            "example": "current-password"
          }
        },
        "additionalProperties": false
      },
      "SettingsAppearance": {
        "type": "object",
        "properties": {
          "theme": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "light",
              "dark",
              "system",
              null
            ],
            "example": "dark"
          },
          "font_family": {
            "type": [
              "string",
              "null"
            ],
            "example": "Marianne"
          },
          "font_size": {
            "type": [
              "integer",
              "null"
            ],
            "example": 16
          },
          "density": {
            "type": [
              "string",
              "null"
            ],
            "example": "compact"
          }
        },
        "required": [
          "theme",
          "font_family",
          "font_size",
          "density"
        ]
      },
      "SettingsAppearancePatch": {
        "type": "object",
        "properties": {
          "theme": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "light",
              "dark",
              "system",
              null
            ],
            "example": "dark"
          },
          "font_family": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "pattern": "\\S",
            "example": "Marianne"
          },
          "font_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 32767,
            "example": 16
          },
          "density": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "compact",
              "normal",
              "comfortable",
              null
            ],
            "example": "compact"
          }
        },
        "additionalProperties": false
      },
      "SettingsGeneral": {
        "type": "object",
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ],
            "example": "fr"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "example": "Europe/Paris"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ],
            "example": "DD/MM/YYYY"
          },
          "home_page": {
            "type": [
              "string",
              "null"
            ],
            "example": "/dashboard"
          },
          "auto_open_notifications": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          }
        },
        "required": [
          "language",
          "timezone",
          "date_format",
          "home_page",
          "auto_open_notifications"
        ]
      },
      "SettingsGeneralPatch": {
        "type": "object",
        "properties": {
          "language": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
            "example": "fr"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "pattern": "\\S",
            "example": "Europe/Paris"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "DD/MM/YYYY",
              "MM/DD/YYYY",
              "YYYY-MM-DD",
              null
            ],
            "example": "DD/MM/YYYY"
          },
          "home_page": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128,
            "pattern": "\\S",
            "example": "/dashboard"
          },
          "auto_open_notifications": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          }
        },
        "additionalProperties": false
      },
      "SettingsNotifications": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "push": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          },
          "desktop": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "messages": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "projects": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "calendar": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          }
        },
        "required": [
          "email",
          "push",
          "desktop",
          "messages",
          "projects",
          "calendar"
        ]
      },
      "SettingsNotificationsPatch": {
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "push": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          },
          "desktop": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "messages": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "projects": {
            "type": [
              "boolean",
              "null"
            ],
            "example": true
          },
          "calendar": {
            "type": [
              "boolean",
              "null"
            ],
            "example": false
          }
        },
        "additionalProperties": false
      },
      "SettingsBootstrap": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/SettingsProfile"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "device_info": {
                  "type": "string"
                },
                "ip_address": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string"
                },
                "revoked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "device_info",
                "ip_address",
                "created_at",
                "expires_at"
              ]
            }
          },
          "appearance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SettingsAppearance"
              },
              {
                "type": "null"
              }
            ]
          },
          "general": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SettingsGeneral"
              },
              {
                "type": "null"
              }
            ]
          },
          "notifications": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SettingsNotifications"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "object",
            "properties": {
              "sessions": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "preferences": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "notifications": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            },
            "required": [
              "sessions",
              "preferences",
              "notifications"
            ]
          }
        },
        "required": [
          "profile",
          "sessions",
          "appearance",
          "general",
          "notifications",
          "sources"
        ]
      },
      "SettingsTwoFactorStatus": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether the account is protected by a second factor.",
            "example": true
          },
          "backup_codes_remaining": {
            "type": "integer",
            "description": "Backup codes not spent yet; 0 when the second factor is off.",
            "example": 10
          }
        },
        "required": [
          "enabled",
          "backup_codes_remaining"
        ]
      },
      "SettingsTwoFactorSetup": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret to type in the authenticator application.",
            "example": "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"
          },
          "otpauth_uri": {
            "type": "string",
            "description": "otpauth:// URI to render as a QR code.",
            "example": "otpauth://totp/Mairie%20360:agent@mairie360.fr?secret=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP&issuer=Mairie%20360"
          }
        },
        "required": [
          "secret",
          "otpauth_uri"
        ]
      },
      "SettingsTwoFactorCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Six-digit code of the authenticator application, or a backup code.",
            "example": "492039"
          }
        },
        "required": [
          "code"
        ]
      },
      "SettingsTwoFactorDisable": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Current password of the account.",
            "example": "current-password"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Six-digit code of the authenticator application, or a backup code.",
            "example": "492039"
          }
        },
        "required": [
          "password",
          "code"
        ]
      },
      "SettingsBackupCodes": {
        "type": "object",
        "properties": {
          "backup_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ten single-use codes (`xxxx-xxxx`), shown once: they cannot be read again.",
            "example": [
              "k3m9-x7p2",
              "a8d4-q1w6"
            ]
          }
        },
        "required": [
          "backup_codes"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the BFF is up",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "security": [],
        "tags": [
          "Connectivity"
        ],
        "summary": "Checks that the upstream APIs are reachable",
        "responses": {
          "200": {
            "description": "Every upstream API is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          },
          "502": {
            "description": "At least one upstream API is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckApisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/bootstrap": {
      "get": {
        "summary": "Load the settings page of the signed-in user",
        "responses": {
          "200": {
            "description": "Core profile, sessions, preferences and notification settings of the signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsBootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Missing, forged or expired session token, or a session Core refuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core rate limit reached: retry after the Retry-After header (seconds)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Profile unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core or the session key (JWT_PUBLIC_KEY, or JWT_SECRET during the HS256 transition) is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/profile": {
      "patch": {
        "summary": "Update the profile of the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile saved, then read again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsProfile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported fields, or a changed `email` without `current_password`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, forged or expired session token, or a session Core refuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "`email` sent with a wrong `current_password`, or an account without password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`email` is already used by another account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core rate limit reached: retry after the Retry-After header (seconds)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Core is unavailable, failed or answered an unexpected status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core or the session key (JWT_PUBLIC_KEY, or JWT_SECRET during the HS256 transition) is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/appearance": {
      "patch": {
        "summary": "Save the appearance settings of the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsAppearancePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "appearance settings saved by Core",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsAppearance"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, forged or expired session token, or a session Core refuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core rate limit reached: retry after the Retry-After header (seconds)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Core is unavailable, failed or answered an unexpected status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core or the session key (JWT_PUBLIC_KEY, or JWT_SECRET during the HS256 transition) is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/settings/general": {
      "patch": {
        "summary": "Save the general settings of the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsGeneralPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "general settings saved by Core",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsGeneral"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unsupported fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, forged or expired session token, or a session Core refuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Core rate limit reached: retry after the Retry-After header (seconds)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Core is unavailable, failed or answered an unexpected status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Core or the session key (JWT_PUBLIC_KEY, or JWT_SECRET during the HS256 transition) is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }

{
  "openapi": "3.1.0",
  "info": {
    "title": "BFF Settings API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "SettingsProfile": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "first_name",
          "last_name",
          "email"
        ]
      },
      "SettingsProfilePatch": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "SettingsBootstrap": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/SettingsProfile"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "device_info": {
                  "type": "string"
                },
                "ip_address": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string"
                },
                "revoked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "device_info",
                "ip_address",
                "created_at",
                "expires_at"
              ]
            }
          },
          "sources": {
            "type": "object",
            "properties": {
              "sessions": {
                "type": "string",
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            },
            "required": [
              "sessions"
            ]
          }
        },
        "required": [
          "profile",
          "sessions",
          "sources"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Connectivity"
        ],
        "summary": "Vérifie la santé du BFF",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/check_apis": {
      "get": {
        "responses": {
          "200": {
            "description": "Services disponibles"
          },
          "502": {
            "description": "Service indisponible"
          }
        }
      }
    },
    "/settings/bootstrap": {
      "get": {
        "responses": {
          "200": {
            "description": "Profil et sessions Core de l’utilisateur connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsBootstrap"
                }
              }
            }
          },
          "401": {
            "description": "Session invalide"
          },
          "502": {
            "description": "Profil indisponible"
          }
        }
      }
    },
    "/settings/profile": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsProfilePatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profil sauvegardé puis relu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsProfile"
                }
              }
            }
          },
          "400": {
            "description": "Champs invalides ou non pris en charge"
          }
        }
      }
    },
    "/settings/notifications": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Préférences enregistrées par Core"
          },
          "404": {
            "description": "Fonction non disponible dans Core"
          }
        }
      }
    },
    "/settings/appearance": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Préférences enregistrées par Core"
          },
          "404": {
            "description": "Fonction non disponible dans Core"
          }
        }
      }
    },
    "/settings/general": {
      "patch": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Préférences enregistrées par Core"
          },
          "404": {
            "description": "Fonction non disponible dans Core"
          }
        }
      }
    }
  },
  "webhooks": {}
}

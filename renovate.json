{
  "extends": [
    "github>mairie360/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keeps cicd_version aligned with the mairie360/CICD tag of the reusable workflow",
      "fileMatch": [
        "^\\.github/workflows/(cicd|promote-staging|promote-prod|gdpr-pr)\\.yml$"
      ],
      "matchStrings": [
        "cicd_version:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "mairie360/CICD",
      "datasourceTemplate": "github-tags"
    }
  ]
}

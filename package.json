{
  "name": "bff-settings",
  "version": "1.0.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest",
    "openapi:extract": "ts-node scripts/export-swagger.ts",
    "contracts:generate": "npm run openapi:extract && node scripts/contracts.mjs --generate",
    "contracts:check": "npm run openapi:extract -- --check && node scripts/contracts.mjs --check"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.6.5",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "@types/swagger-ui-express": "4.1.8",
    "@types/node": "^24.0.0"
  }
}
